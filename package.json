{
  "name": "poker-analysis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Free, private, in-browser poker hand history analyzer with chess.com-style hand reviews, leak detection and training drills.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "gen:demo": "node --experimental-strip-types scripts/generate-demo.ts",
    "build:solver": "./scripts/build-solver.sh",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/status-bar": "8.0.4",
    "@supabase/supabase-js": "2.118.0",
    "fflate": "^0.8.2",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.66.0",
    "phe": "^0.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "license": "AGPL-3.0-or-later"
}
